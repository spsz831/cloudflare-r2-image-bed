{
  "rules": [
    {
      "allowed_origins": [
        "https://19950906.xyz",
        "https://www.19950906.xyz"
      ],
      "allowed_methods": ["GET", "PUT", "POST", "DELETE", "HEAD"],
      "allowed_headers": [
        "Accept",
        "Accept-Language",
        "Content-Language",
        "Content-Type",
        "Authorization",
        "X-Requested-With"
      ],
      "expose_headers": [
        "Content-Length",
        "Content-Type",
        "Last-Modified",
        "ETag"
      ],
      "max_age_seconds": 3600
    }
  ]
}
